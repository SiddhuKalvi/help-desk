# Used for e2e (Playwright) test runs — a separate database and ports from
# normal dev, so `bun run test:e2e` never touches real dev data and can run
# alongside a `bun run dev` session. See e2e/README.md for the one-time setup.

DATABASE_URL="postgresql://<user>:<password>@localhost:5432/helpdesk_test?schema=public"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="<run: openssl rand -base64 32>"
BETTER_AUTH_URL="http://localhost:3002"
CLIENT_URL="http://localhost:5174"
PORT="3002"

# Seed script (bun run test:seed) - creates/updates the e2e test admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<choose a test-only password>"

# Agent seed script (bun run test:seed:agent) - creates/updates an e2e test agent user
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="<choose a test-only password>"

# Inbound email webhook (POST /api/tickets/inbound)
INBOUND_EMAIL_WEBHOOK_SECRET="test-webhook-secret"

# AI agent seed (bun run seed:ai-agent) - the permanent, non-login agent user
# that auto-resolved tickets are assigned to. Optional; defaults to ai@helpdesk.local if unset.
AI_AGENT_EMAIL="ai@helpdesk.local"

# OpenRouter (used by POST /api/tickets/:id/replies/polish to polish agent reply drafts via openrouter/free)
OPENROUTER_API_KEY="sk-or-v1-..."