# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://<user>:<password>@localhost:5432/helpdesk?schema=public"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="<run: openssl rand -base64 32>"
BETTER_AUTH_URL="http://localhost:3001"
CLIENT_URL="http://localhost:5173"

# Seed script (bun prisma/seed.ts) - creates/updates the initial admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<choose a real password before running the seed script>"

# Inbound email webhook (POST /api/tickets/inbound)
# Generate with: openssl rand -base64 32
INBOUND_EMAIL_WEBHOOK_SECRET="<run: openssl rand -base64 32>"

# AI agent seed (bun run seed:ai-agent) - the permanent, non-login agent user
# that auto-resolved tickets are assigned to. Optional; defaults to ai@helpdesk.local if unset.
AI_AGENT_EMAIL="ai@helpdesk.local"

# OpenRouter (used by POST /api/tickets/:id/replies/polish to polish agent reply drafts via openrouter/free)
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Mailgun (used by POST /api/tickets/:id/replies to email the customer after an agent reply)
# Get an API key at https://app.mailgun.com/settings/api_security
MAILGUN_API_KEY="<your Mailgun API key>"
MAILGUN_DOMAIN="mg.example.com"
MAILGUN_FROM="Help Desk <support@example.com>"

# Sentry (error monitoring; optional — leave empty to disable locally)
SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project-id>"